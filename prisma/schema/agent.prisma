model AgentRun {
  id           String         @id @default(cuid())
  triggerEvent String
  status       AgentRunStatus @default(QUEUED)
  planSummary  String?
  steps        AgentStep[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AgentStep {
  id               String   @id @default(cuid())
  runId            String
  agentRun         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepNumber       Int
  toolName         String
  toolInput        Json
  toolOutput       Json?
  requiresApproval Boolean  @default(false)
  isApproved       Boolean?
  createdAt        DateTime @default(now())

  @@index([runId])
}
